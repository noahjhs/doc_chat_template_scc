OPENAI_API_KEY=
# Public tunnel hostname for auth_service, e.g. auth.example.com -- used both
# by casper_tool.py (on end users' machines) and by the app container's own
# server-side calls (see docker-compose.yml / plan notes on why this is the
# public hostname rather than an internal Compose service name).
AUTH_SERVICE_DOMAIN=
AUTH_DB_PATH=/data/users.db
STORAGE_ROOT=/data/storage
